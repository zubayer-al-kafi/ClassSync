<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_classroomDetailFragment"
            app:destination="@id/classroomDetailFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_markAttendanceFragment"
            app:destination="@id/markAttendanceFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_attendanceHistoryFragment"
            app:destination="@id/attendanceHistoryFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_createClassroomFragment"
            app:destination="@id/createClassroomFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_manageClassroomsFragment"
            app:destination="@id/manageClassroomsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_joinClassroomFragment"
            app:destination="@id/joinClassroomFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_teacherMarkAttendanceFragment"
            app:destination="@id/teacherMarkAttendanceFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_classRosterFragment"
            app:destination="@id/classRosterFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_generateQrFragment"
            app:destination="@id/generateQrFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_scanQrFragment"
            app:destination="@id/scanQrFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_courseMaterialsFragment"
            app:destination="@id/courseMaterialsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_assignmentsFragment"
            app:destination="@id/assignmentsFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.AccountFragment"
        android:label="My Account"
        tools:layout="@layout/fragment_account">
        <action
            android:id="@+id/action_accountFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/classroomDetailFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.ClassroomDetailFragment"
        android:label="Course Hub"
        tools:layout="@layout/fragment_classroom_detail">
        <action
            android:id="@+id/action_classroomDetailFragment_to_teacherMarkAttendanceFragment"
            app:destination="@id/teacherMarkAttendanceFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_generateQrFragment"
            app:destination="@id/generateQrFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_classRosterFragment"
            app:destination="@id/classRosterFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_editClassroomFragment"
            app:destination="@id/editClassroomFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_scanQrFragment"
            app:destination="@id/scanQrFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_markAttendanceFragment"
            app:destination="@id/markAttendanceFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_courseMaterialsFragment"
            app:destination="@id/courseMaterialsFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_assignmentsFragment"
            app:destination="@id/assignmentsFragment" />
        <action
            android:id="@+id/action_classroomDetailFragment_to_attendanceHistoryFragment"
            app:destination="@id/attendanceHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/manageClassroomsFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.ManageClassroomsFragment"
        android:label="Classrooms"
        tools:layout="@layout/fragment_manage_classrooms">
        <action
            android:id="@+id/action_manageClassroomsFragment_to_classroomDetailFragment"
            app:destination="@id/classroomDetailFragment" />
        <action
            android:id="@+id/action_manageClassroomsFragment_to_createClassroomFragment"
            app:destination="@id/createClassroomFragment" />
        <action
            android:id="@+id/action_manageClassroomsFragment_to_editClassroomFragment"
            app:destination="@id/editClassroomFragment" />
        <action
            android:id="@+id/action_manageClassroomsFragment_to_teacherMarkAttendanceFragment"
            app:destination="@id/teacherMarkAttendanceFragment" />
        <action
            android:id="@+id/action_manageClassroomsFragment_to_classRosterFragment"
            app:destination="@id/classRosterFragment" />
    </fragment>

    <fragment
        android:id="@+id/editClassroomFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.EditClassroomFragment"
        android:label="Edit Schedule &amp; Settings"
        tools:layout="@layout/fragment_edit_classroom" />

    <fragment
        android:id="@+id/createClassroomFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.CreateClassroomFragment"
        android:label="Create Classroom"
        tools:layout="@layout/fragment_create_classroom">
        <action
            android:id="@+id/action_createClassroomFragment_to_classroomDetailFragment"
            app:destination="@id/classroomDetailFragment"
            app:popUpTo="@id/createClassroomFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/joinClassroomFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.JoinClassroomFragment"
        android:label="Join Classroom"
        tools:layout="@layout/fragment_join_classroom" />

    <fragment
        android:id="@+id/teacherMarkAttendanceFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.TeacherMarkAttendanceFragment"
        android:label="Class Attendance"
        tools:layout="@layout/fragment_teacher_mark_attendance" />

    <fragment
        android:id="@+id/classRosterFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.ClassRosterFragment"
        android:label="Class Analytics"
        tools:layout="@layout/fragment_class_roster" />

    <fragment
        android:id="@+id/generateQrFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.GenerateQrFragment"
        android:label="Generate QR Code"
        tools:layout="@layout/fragment_generate_qr" />

    <fragment
        android:id="@+id/scanQrFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.ScanQrFragment"
        android:label="Scan QR Code"
        tools:layout="@layout/fragment_scan_qr">
        <action
            android:id="@+id/action_scanQrFragment_to_attendanceHistoryFragment"
            app:destination="@id/attendanceHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/markAttendanceFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.MarkAttendanceFragment"
        android:label="@string/title_mark_attendance"
        tools:layout="@layout/fragment_mark_attendance">
        <action
            android:id="@+id/action_markAttendanceFragment_to_attendanceHistoryFragment"
            app:destination="@id/attendanceHistoryFragment" />
        <action
            android:id="@+id/action_markAttendanceFragment_to_scanQrFragment"
            app:destination="@id/scanQrFragment" />
    </fragment>

    <fragment
        android:id="@+id/attendanceHistoryFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.AttendanceHistoryFragment"
        android:label="@string/title_attendance_history"
        tools:layout="@layout/fragment_attendance_history" />

    <fragment
        android:id="@+id/courseMaterialsFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.CourseMaterialsFragment"
        android:label="Course Stream &amp; Notes"
        tools:layout="@layout/fragment_course_materials" />

    <fragment
        android:id="@+id/assignmentsFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.AssignmentsFragment"
        android:label="Assignments"
        tools:layout="@layout/fragment_assignments">
        <action
            android:id="@+id/action_assignmentsFragment_to_submitAssignmentFragment"
            app:destination="@id/submitAssignmentFragment" />
        <action
            android:id="@+id/action_assignmentsFragment_to_gradeSubmissionsFragment"
            app:destination="@id/gradeSubmissionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/submitAssignmentFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.SubmitAssignmentFragment"
        android:label="Submit Work"
        tools:layout="@layout/fragment_submit_assignment" />

    <fragment
        android:id="@+id/gradeSubmissionsFragment"
        android:name="com.example.smartattendancemanagementsystem.ui.GradeSubmissionsFragment"
        android:label="Grade Submissions"
        tools:layout="@layout/fragment_grade_submissions" />

</navigation>
